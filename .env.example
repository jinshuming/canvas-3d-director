# Copy to .env.local (gitignored). Keys are read by the dev server only, never sent to the page.

# Viggle API: generating scenes, characters and motions. Without it only the presets work.
VIGGLE_API_KEY=
# VIGGLE_API_BASE_URL=

# The World agent (OpenAI Responses API).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=
