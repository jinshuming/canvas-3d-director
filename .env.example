# Copy to .env.local (gitignored). Keys are read by the dev server only, never sent to the page.

# Viggle API: generating scenes, characters and motions. Without it only the presets work.
VIGGLE_API_KEY=
# VIGGLE_API_BASE_URL=

# The director's agent and the scene generator's layout / panorama (OpenAI Responses + image API).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_BASE_URL=

# The scene generator (/canvas scene nodes).
# fal.ai: SAM 3D objects (and the optional FLUX depth panorama provider). Without it scenes have no separate objects.
FAL_KEY=
# The image model that paints panoramas and object crops.
# SCENEGEN_IMAGE_MODEL=gpt-image-2
# A real JST-2 posed-images endpoint for the video route (unset: the built-in mock).
# SCENEGEN_POSED_IMAGES_BASE=
